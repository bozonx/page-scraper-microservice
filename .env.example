# Application environment: development | production | test.
NODE_ENV=development
# HTTP bind address and port.
LISTEN_HOST=localhost
LISTEN_PORT=8080
# Optional proxy path prefix.
# BASE_PATH=
# Pino level and timezone.
LOG_LEVEL=debug
TZ=UTC
# Optional service-name override.
# SERVICE_NAME=
# Seconds health reports shutting_down before closing.
SHUTDOWN_DRAIN_SECONDS=5
# Serve the bundled test UI.
ENABLE_UI=false
# Optional Basic and Bearer credentials.
# AUTH_BASIC_USER=
# AUTH_BASIC_PASS=
# AUTH_BEARER_TOKENS=

# Global heavy-task concurrency and queue limits.
MAX_CONCURRENCY=3
MAX_QUEUE=100
# Playwright-specific concurrency and queue limits.
MAX_BROWSER_CONCURRENCY=1
MAX_BROWSER_QUEUE=50
# Default scraper mode and task timeout.
DEFAULT_MODE=extractor
DEFAULT_TASK_TIMEOUT_SECS=60
# Browser fingerprint defaults.
DEFAULT_FINGERPRINT_USER_AGENT=auto
DEFAULT_FINGERPRINT_LOCALE=en-US
DEFAULT_FINGERPRINT_TIMEZONE_ID=UTC
DEFAULT_FINGERPRINT_GENERATE=true
DEFAULT_FINGERPRINT_ROTATE_ON_ANTI_BOT=true
# Playwright browser behavior.
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAVIGATION_TIMEOUT_SECS=30
DEFAULT_PLAYWRIGHT_BLOCK_TRACKERS=true
DEFAULT_PLAYWRIGHT_BLOCK_HEAVY_RESOURCES=true
PLAYWRIGHT_EXTRA_ARGS=[]
# Fetch retry, redirect and response-size limits.
FETCH_RETRY_MAX_ATTEMPTS=3
FETCH_MAX_REDIRECTS=7
FETCH_MAX_RESPONSE_BYTES=10485760
# File proxy redirect and response-size limits.
FILE_MAX_REDIRECTS=7
FILE_MAX_RESPONSE_BYTES=26214400
